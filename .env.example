# Copiez ce fichier en `.env` pour le développement local (le vrai .env n'est jamais versionné).

# --- Obligatoire ---
# Générer une clé :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=remplacez-moi
# True en local uniquement. Vaut False par défaut si la variable est absente.
DEBUG=True

# --- Production ---
# Domaines autorisés, séparés par des virgules. (Render et Railway ajoutent le leur automatiquement.)
# ALLOWED_HOSTS=monsite.com,www.monsite.com
# Origines de confiance pour les formulaires POST (avec https://).
# CSRF_TRUSTED_ORIGINS=https://monsite.com,https://www.monsite.com
# PostgreSQL (fourni par la plateforme). Sans cette variable : SQLite local.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base

# --- Création automatique du super-utilisateur (build Render) ---
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@exemple.com
# DJANGO_SUPERUSER_PASSWORD=un-mot-de-passe-solide
# LOAD_DEMO_DATA=0

# --- E-mail (notifications du formulaire de contact) ---
# CONTACT_RECIPIENT=moi@exemple.com
# DEFAULT_FROM_EMAIL=no-reply@monsite.com
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Divers ---
# CURRENCY_SYMBOL=$
# CURRENCY_CODE=USD
# MEDIA_ROOT=/chemin/vers/disque/persistant
